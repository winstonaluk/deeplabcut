{"nodes": [{"id": "acquisition_requirements_numpy_upper_bound", "label": "numpy<2 Upper Bound (acquisition)", "file_type": "rationale", "source_file": "acquisition/requirements.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PySpin does not support numpy 2.x; unbounded, a fresh install pulls 2.x and `import PySpin` stops working, so the upper bound is load-bearing rather than cautious."}, {"id": "acquisition_requirements_tomli_backport", "label": "tomli Backport for Python 3.10", "file_type": "rationale", "source_file": "acquisition/requirements.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "tomllib is stdlib only from 3.11, and the acquisition PC runs 3.10 because its PySpin wheel is cp310-only \u2014 so the Python pin propagates into how config is loaded."}, {"id": "acquisition_requirements_pyspin_not_on_pypi", "label": "PySpin Is Vendor-Distributed, Not on PyPI", "file_type": "rationale", "source_file": "acquisition/requirements.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The wheel must match your Python/OS and comes from the Spinnaker SDK download after installing the SDK itself; it is only required for SpinnakerCamera, since MockCamera and all tests run without it."}], "edges": [{"source": "acquisition_requirements_numpy_upper_bound", "target": "docs_pyspinreadme_numpy_2x_notice", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "acquisition/requirements.txt", "source_location": null, "weight": 1.0}, {"source": "acquisition_requirements_tomli_backport", "target": "acquisition_acquisition_hardware_bfs_u3_04s2c", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "acquisition/requirements.txt", "source_location": null, "weight": 1.0}, {"source": "acquisition_requirements_pyspin_not_on_pypi", "target": "docs_pyspinreadme_spinnaker_python_package", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "acquisition/requirements.txt", "source_location": null, "weight": 1.0}, {"source": "acquisition_requirements_pyspin_not_on_pypi", "target": "acquisition_claude_invariant_2_mock_first_class", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "acquisition/requirements.txt", "source_location": null, "weight": 1.0}], "hyperedges": []}